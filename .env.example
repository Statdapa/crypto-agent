DB_PATH=crypto_intelligence_agent.db
GROQ_API_KEY=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
ETHERSCAN_API_KEY=
WALLET_ADDRESS=
OKX_API_KEY=
OKX_SECRET_KEY=
