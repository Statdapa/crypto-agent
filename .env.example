# Paper-only demo ledger (shared between demo-watch and Telegram bot)
PAPER_DB_PATH=data/paper_trading.db

# Full active Binance spot-USDT universe is scanned automatically and via /scanall.
# Only these symbols receive scheduled deep RSI/MACD snapshots (rate limited).
MARKET_COINS=BTC,ETH,SOL
SNAPSHOT_INTERVAL_MINUTES=15
